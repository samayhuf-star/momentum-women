{
  "expo": {
    "name": "Momentum – Women's Workout",
    "slug": "momentum-women",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samayvashsht.momentumwomen",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.samayvashsht.momentumwomen",
      "adaptiveIcon": {
        "backgroundColor": "#FFF5F8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF5F8"
        }
      ]
    ],
    "scheme": "momentum-women",
    "extra": {
      "eas": {
        "projectId": "53a2cf35-ce2a-4aa6-aa9f-f63b318a9f5f"
      }
    },
    "owner": "krosz"
  }
}
